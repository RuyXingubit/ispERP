# ==============================================================================
# Stage 1: Build Central do Assinante (frontend-customer - Vanilla TS + Vite 6)
# ==============================================================================
FROM node:24-alpine AS build

WORKDIR /app

# Copy package files
COPY frontend-customer/package*.json ./

# Install dependencies
RUN npm install

# Copy source code and build static bundle
COPY frontend-customer/ ./
RUN npm run build

# ==============================================================================
# Stage 2: Production Nginx Runtime
# ==============================================================================
FROM nginx:alpine

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy built application from Vite dist folder
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
