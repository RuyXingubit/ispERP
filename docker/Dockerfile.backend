# ==============================================================================
# Stage 1: Build Spring Boot Application (Java 25 + OpenAPI Codegen)
# ==============================================================================
FROM eclipse-temurin:25-jdk-alpine AS build

WORKDIR /workspace/backend

# Copy OpenAPI bundled contract required by openApiGenerate task ($rootDir/../contracts/openapi/openapi.bundled.json)
COPY contracts/openapi/openapi.bundled.json /workspace/contracts/openapi/openapi.bundled.json

# Copy Gradle wrapper and build configuration first for layer caching
COPY backend/gradlew ./
COPY backend/gradle ./gradle
COPY backend/build.gradle backend/settings.gradle ./
RUN chmod +x ./gradlew

# Copy backend source code and build executable Boot JAR
COPY backend/src ./src
RUN ./gradlew bootJar -x test --no-daemon

# ==============================================================================
# Stage 2: Production Runtime (Java 25 JRE + PostgreSQL Client for Backup/DR)
# ==============================================================================
FROM eclipse-temurin:25-jre-alpine

WORKDIR /app

# Install curl, postgresql-client (pg_dump / pg_isready) and bash
RUN apk add --no-cache curl postgresql-client bash

# Copy executable JAR from build stage
COPY --from=build /workspace/backend/build/libs/*.jar app.jar

# Copy PostgreSQL readiness wait script
COPY docker/wait-for-postgres.sh wait-for-postgres.sh
RUN chmod +x wait-for-postgres.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/api/actuator/health || exit 1

ENTRYPOINT ["./wait-for-postgres.sh", "java", "-jar", "app.jar"]